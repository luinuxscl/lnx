APP_NAME=Laravel
APP_VERSION=0.1.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
DESIGN_GALLERY_ENABLED=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Initial superuser seeded by RolePermissionSeeder.
# WARNING: these are DEVELOPMENT-ONLY credentials. The app shows a banner and
# refuses to seed this root user in production while the password stays as "password".
ROOT_USER_NAME="Luis Sepulveda"
ROOT_USER_EMAIL=luinuxscl@gmail.com
ROOT_USER_PASSWORD=password

# Read-only application MCP server. Disabled until explicitly enabled.
MCP_SERVER_ENABLED=false
MCP_SERVER_PATH=mcp
MCP_SERVER_PER_PAGE=10
MCP_SERVER_MAX_PER_PAGE=50
MCP_SERVER_RATE_LIMIT=60
MCP_SERVER_AUDIT_RETENTION_DAYS=90
# MCP_SERVER_TOKEN_EXPIRES_DAYS=

# AI (Laravel AI SDK + OpenRouter). Disabled until explicitly enabled.
AI_ENABLED=false
AI_PROVIDER=openrouter
# The model must also be listed in config/lnx_ai.php (allowed_models). No model is pinned in code.
AI_MODEL=
AI_TIMEOUT=30
AI_MAX_OUTPUT_TOKENS=1024
AI_CONNECTION_TEST_TIMEOUT=15
AI_CONNECTION_TEST_MAX_OUTPUT_TOKENS=16
AI_CONNECTION_TEST_RATE_LIMIT=5
# OpenRouter API key for the deployment. Required once AI is enabled.
OPENROUTER_API_KEY=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
