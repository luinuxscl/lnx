APP_NAME=LNX
APP_VERSION=0.1.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
DESIGN_GALLERY_ENABLED=true
APP_URL=http://localhost:8000

# Shared UI package (x-lnx-ui::). The admin page for lnx-ui reads the installed
# version from Composer and the latest tag from the GitHub API. The package
# registry page (/admin/packages) uses the same version check for every
# registered package. These repositories are private, so GITHUB_TOKEN is
# required to resolve the latest version.
LNX_UI_REPOSITORY=luinuxscl/lnx-ui
GITHUB_TOKEN=
# PACKAGES_UPDATE_CHECK_TTL=3600

# lnx identity defaults. Empty site settings fall back to these values.
APP_TAGLINE="Base de desarrollo Laravel"
APP_FOOTER_TEXT="Hecho por Like Innovación"

APP_TIMEZONE=America/Santiago

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Initial superuser seeded by RolePermissionSeeder.
# WARNING: these are DEVELOPMENT-ONLY credentials. The app shows a banner and
# refuses to seed this root user in production while the password stays as "password".
ROOT_USER_NAME="Luis Sepulveda"
ROOT_USER_EMAIL=luinuxscl@gmail.com
ROOT_USER_PASSWORD=password

# Read-only application MCP server. Disabled until explicitly enabled.
MCP_SERVER_ENABLED=false
MCP_SERVER_PATH=mcp
MCP_SERVER_PER_PAGE=10
MCP_SERVER_MAX_PER_PAGE=50
MCP_SERVER_RATE_LIMIT=60
MCP_SERVER_AUDIT_RETENTION_DAYS=90
# MCP_SERVER_TOKEN_EXPIRES_DAYS=

# AI (Laravel AI SDK + OpenRouter). Disabled until explicitly enabled.
AI_ENABLED=false
AI_PROVIDER=openrouter
# The model must also be listed in config/lnx_ai.php (allowed_models) or via AI_ALLOWED_MODELS. No model is pinned in code.
AI_MODEL=
# Optional JSON allowlist merged over config/lnx_ai.php. Example:
# AI_ALLOWED_MODELS={"vendor/model-id":{"tools":false,"structured":false,"streaming":true,"context":128000}}
AI_ALLOWED_MODELS=
AI_TIMEOUT=30
AI_MAX_OUTPUT_TOKENS=1024
AI_CONNECTION_TEST_TIMEOUT=15
AI_CONNECTION_TEST_MAX_OUTPUT_TOKENS=16
AI_CONNECTION_TEST_RATE_LIMIT=5
# Reusable text assistant (improve, summarize, translate). The demo screen is opt-in.
AI_TEXT_ASSISTANT_TIMEOUT=30
AI_TEXT_ASSISTANT_MAX_OUTPUT_TOKENS=1200
AI_TEXT_ASSISTANT_MAX_INPUT_CHARS=8000
AI_TEXT_ASSISTANT_DEMO_ENABLED=false
# Document extraction settings and limits
AI_DOCUMENT_TIMEOUT=60
AI_DOCUMENT_MAX_OUTPUT_TOKENS=2048
AI_DOCUMENT_MAX_FILE_SIZE_KB=10240
AI_DOCUMENT_MAX_PAGES=20
# Usage limits (window: minute|hour|day). Requests must satisfy both dimensions.
AI_USER_LIMIT_WINDOW=hour
AI_USER_LIMIT_REQUESTS=60
AI_USER_LIMIT_TOKENS=200000
AI_DEFAULT_LIMIT_WINDOW=hour
AI_DEFAULT_LIMIT_REQUESTS=60
AI_DEFAULT_LIMIT_TOKENS=200000
AI_CONNECTION_TEST_LIMIT_WINDOW=hour
AI_CONNECTION_TEST_LIMIT_REQUESTS=5
AI_CONNECTION_TEST_LIMIT_TOKENS=2000
AI_TEXT_ASSISTANT_LIMIT_WINDOW=hour
AI_TEXT_ASSISTANT_LIMIT_REQUESTS=30
AI_TEXT_ASSISTANT_LIMIT_TOKENS=100000
AI_DOCUMENT_LIMIT_WINDOW=hour
AI_DOCUMENT_LIMIT_REQUESTS=20
AI_DOCUMENT_LIMIT_TOKENS=100000
# Optional cost estimation rates (per million tokens). No rate means unknown cost.
AI_PRICING_VERSION=
AI_PRICING_UPDATED_AT=
AI_PRICING_CURRENCY=USD
# AI_PRICING_MODELS={"vendor/model-id":{"input_per_million":3,"output_per_million":15}}
AI_PRICING_MODELS=
AI_USAGE_RETENTION_DAYS=90
# OpenRouter API key for the deployment. Required once AI is enabled.
OPENROUTER_API_KEY=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@luinuxscl.com"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
